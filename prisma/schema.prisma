generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  passwordHash   String
  role           String           // EMPLOYEE, MANAGER, ADMIN
  managerId      String?
  manager        User?            @relation("ManagerToEmployee", fields: [managerId], references: [id])
  employees      User[]           @relation("ManagerToEmployee")
  goals          Goal[]           @relation("EmployeeGoals")
  sharedGoals    SharedGoalLink[] @relation("RecipientSharedGoals")
  audits         AuditLog[]       @relation("UserAudits")
  primaryOwnerOf Goal[]           @relation("PrimaryOwnerGoals")
  oneOnOnesAsEmployee OneOnOne[]  @relation("EmployeeOneOnOnes")
  oneOnOnesAsManager  OneOnOne[]  @relation("ManagerOneOnOnes")
  feedbackGiven       Feedback[]  @relation("FeedbackGiven")
  feedbackReceived    Feedback[]  @relation("FeedbackReceived")
  growthAreas         GrowthArea[] @relation("EmployeeGrowthAreas")
  
  // New relations for Performance Suite
  reviewsReceived     Review[]     @relation("Reviewee")
  reviewsWritten      Review[]     @relation("Reviewer")
  talentRatings       TalentRating[] @relation("UserTalentRatings")
  pips                Pip[]        @relation("UserPIPs")
  successionFor       SuccessionPlan[] @relation("Successor")
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Cycle {
  id          String   @id @default(cuid())
  name        String
  phase       String   // GOAL_SETTING, CHECK_IN_Q1, CHECK_IN_Q2, CHECK_IN_Q3, CHECK_IN_Q4, CLOSED
  windowOpen  DateTime
  windowClose DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Goal {
  id             String           @id @default(cuid())
  employeeId     String
  employee       User             @relation("EmployeeGoals", fields: [employeeId], references: [id])
  thrustArea     String
  title          String
  description    String?
  uomType        String           // NUMERIC_MIN, NUMERIC_MAX, TIMELINE, ZERO
  target         Float
  weightage      Int
  status         String           // DRAFT, PENDING_APPROVAL, APPROVED, REWORK
  lockedAt       DateTime?
  isShared       Boolean          @default(false)
  primaryOwnerId String?
  primaryOwner   User?            @relation("PrimaryOwnerGoals", fields: [primaryOwnerId], references: [id])
  checkIns       CheckIn[]
  auditLogs      AuditLog[]
  sharedLinks    SharedGoalLink[] @relation("SourceGoalLinks")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CheckIn {
  id                String   @id @default(cuid())
  goalId            String
  goal              Goal     @relation(fields: [goalId], references: [id])
  quarter           String   // Q1, Q2, Q3, Q4_ANNUAL
  actualAchievement Float
  progressScore     Float?
  goalStatus        String   // NOT_STARTED, ON_TRACK, COMPLETED
  managerComment    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([goalId, quarter])
}

model AuditLog {
  id           String   @id @default(cuid())
  goalId       String
  goal         Goal     @relation(fields: [goalId], references: [id])
  changedById  String
  changedBy    User     @relation("UserAudits", fields: [changedById], references: [id])
  fieldChanged String
  oldValue     String?
  newValue     String?
  changedAt    DateTime @default(now())
}

model SharedGoalLink {
  id                  String @id @default(cuid())
  sourceGoalId        String
  sourceGoal          Goal   @relation("SourceGoalLinks", fields: [sourceGoalId], references: [id])
  recipientEmployeeId String
  recipientEmployee   User   @relation("RecipientSharedGoals", fields: [recipientEmployeeId], references: [id])
  recipientWeightage  Int
}

model OneOnOne {
  id             String   @id @default(cuid())
  employeeId     String
  employee       User     @relation("EmployeeOneOnOnes", fields: [employeeId], references: [id])
  managerId      String
  manager        User     @relation("ManagerOneOnOnes", fields: [managerId], references: [id])
  date           DateTime
  talkingPoints  String?
  actionItems    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Feedback {
  id             String   @id @default(cuid())
  fromUserId     String
  fromUser       User     @relation("FeedbackGiven", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User     @relation("FeedbackReceived", fields: [toUserId], references: [id])
  content        String
  visibility     String   // PUBLIC, PRIVATE_TO_MANAGER
  createdAt      DateTime @default(now())
}

model GrowthArea {
  id             String   @id @default(cuid())
  employeeId     String
  employee       User     @relation("EmployeeGrowthAreas", fields: [employeeId], references: [id])
  title          String
  description    String?
  status         String   // NOT_STARTED, IN_PROGRESS, ACHIEVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- NEW PERFORMANCE MODULES ---

model ReviewCycle {
  id          String   @id @default(cuid())
  name        String   // e.g. "Annual Review 2024"
  status      String   // DRAFT, ACTIVE, COMPLETED
  startDate   DateTime
  endDate     DateTime
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id            String      @id @default(cuid())
  cycleId       String
  cycle         ReviewCycle @relation(fields: [cycleId], references: [id])
  revieweeId    String
  reviewee      User        @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewerId    String
  reviewer      User        @relation("Reviewer", fields: [reviewerId], references: [id])
  type          String      // SELF, MANAGER, PEER
  content       String      // Markdown or JSON answers
  score         Float?
  status        String      // PENDING, SUBMITTED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model TalentRating {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("UserTalentRatings", fields: [userId], references: [id])
  performance    Int      // 1-3 (Low, Medium, High)
  potential      Int      // 1-3 (Low, Medium, High)
  managerComment String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Pip {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("UserPIPs", fields: [userId], references: [id])
  title          String
  description    String
  startDate      DateTime
  endDate        DateTime
  status         String   // ACTIVE, COMPLETED_SUCCESS, COMPLETED_FAILED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SuccessionPlan {
  id             String   @id @default(cuid())
  roleTitle      String
  successorId    String
  successor      User     @relation("Successor", fields: [successorId], references: [id])
  readiness      String   // READY_NOW, READY_1_YEAR, READY_2_PLUS_YEARS
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
